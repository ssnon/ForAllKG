from __future__ import annotations

from collections import Counter
from dataclasses import dataclass
from enum import Enum

from dac_her.validation_issues import IssueCode, ValidationReport


class RecoveryAction(str, Enum):
    ACCEPT = "accept"
    NORMALIZE = "normalize"
    SEMANTIC_PATCH = "semantic_patch"
    RECHUNK = "rechunk"
    MICRO_REEXTRACT = "micro_reextract"
    QUARANTINE = "quarantine"


@dataclass(frozen=True)
class RecoveryDecision:
    action: RecoveryAction
    reason: str
    issue_codes: tuple[str, ...]

UNDEFINED_ENDPOINT_CODES = {
    IssueCode.UNDEFINED_EDGE_SOURCE,
    IssueCode.UNDEFINED_EDGE_TARGET,
}


def has_common_undefined_endpoint_cluster(
    report: ValidationReport,
    *,
    min_count: int = 2,
) -> bool:
    """True for a homogeneous undefined-endpoint residual sharing one node ID."""
    error_issues = [
        item
        for item in report.issues
        if item.severity.value == "error"
    ]
    if not error_issues:
        return False
    if any(item.code not in UNDEFINED_ENDPOINT_CODES for item in error_issues):
        return False

    endpoint_counts: Counter[str] = Counter()
    for item in error_issues:
        if item.code == IssueCode.UNDEFINED_EDGE_SOURCE and item.source_id:
            endpoint_counts[item.source_id] += 1
        elif item.code == IssueCode.UNDEFINED_EDGE_TARGET and item.target_id:
            endpoint_counts[item.target_id] += 1

    return bool(endpoint_counts) and max(endpoint_counts.values()) >= min_count


def has_dominant_undefined_endpoint_cluster(
    report: ValidationReport,
    *,
    min_count: int = 3,
    min_error_share: float = 0.5,
) -> bool:
    """Detect one missing node that dominates a mixed validation residual."""
    error_issues = [
        item
        for item in report.issues
        if item.severity.value == "error"
    ]
    if not error_issues:
        return False

    endpoint_counts: Counter[str] = Counter()
    for item in error_issues:
        if item.code == IssueCode.UNDEFINED_EDGE_SOURCE and item.source_id:
            endpoint_counts[item.source_id] += 1
        elif item.code == IssueCode.UNDEFINED_EDGE_TARGET and item.target_id:
            endpoint_counts[item.target_id] += 1

    if not endpoint_counts:
        return False

    dominant_count = max(endpoint_counts.values())
    if dominant_count < min_count:
        return False

    return (dominant_count / len(error_issues)) >= min_error_share


_CLAIM_SPECIFIC_CODES = {
    IssueCode.CLAIM_MISSING_APPLICATION_TARGET,
    IssueCode.OBSERVATION_MISSING_SUPPORT,
    IssueCode.MECHANISM_MISSING_SUPPORT,
    IssueCode.CLAIM_LIKE_ENTITY,
}

_CLAIM_RELATIONS = {
    "SUPPORTS_CLAIM",
    "INTERPRETED_AS",
    "APPLIES_TO",
}


def has_coupled_claim_subgraph_residual(
    report: ValidationReport,
) -> bool:
    """Detect a claim subgraph whose errors should be rebuilt as a unit."""
    error_issues = [
        item
        for item in report.issues
        if item.severity.value == "error"
    ]
    if not error_issues:
        return False

    has_claim_issue = any(
        item.code in _CLAIM_SPECIFIC_CODES
        for item in error_issues
    )
    has_claim_relation_issue = any(
        (
            item.code
            in {
                IssueCode.RELATION_SOURCE_TYPE_MISMATCH,
                IssueCode.RELATION_TARGET_TYPE_MISMATCH,
            }
            and item.relation in _CLAIM_RELATIONS
        )
        for item in error_issues
    )

    return has_claim_issue and has_claim_relation_issue


def has_dominant_undefined_endpoint_cluster(
    report: ValidationReport,
    *,
    min_count: int = 3,
    min_error_share: float = 0.5,
) -> bool:
    """Detect one missing node that dominates a mixed validation residual."""
    error_issues = [
        item
        for item in report.issues
        if item.severity.value == "error"
    ]
    if not error_issues:
        return False

    endpoint_counts: Counter[str] = Counter()
    for item in error_issues:
        if item.code == IssueCode.UNDEFINED_EDGE_SOURCE and item.source_id:
            endpoint_counts[item.source_id] += 1
        elif item.code == IssueCode.UNDEFINED_EDGE_TARGET and item.target_id:
            endpoint_counts[item.target_id] += 1

    if not endpoint_counts:
        return False

    dominant_count = max(endpoint_counts.values())
    if dominant_count < min_count:
        return False

    return (dominant_count / len(error_issues)) >= min_error_share


_CLAIM_SPECIFIC_CODES = {
    IssueCode.CLAIM_MISSING_APPLICATION_TARGET,
    IssueCode.OBSERVATION_MISSING_SUPPORT,
    IssueCode.MECHANISM_MISSING_SUPPORT,
    IssueCode.CLAIM_LIKE_ENTITY,
}

_CLAIM_RELATIONS = {
    "SUPPORTS_CLAIM",
    "INTERPRETED_AS",
    "APPLIES_TO",
}


def has_coupled_claim_subgraph_residual(
    report: ValidationReport,
) -> bool:
    """Detect a claim subgraph whose errors should be rebuilt as a unit."""
    error_issues = [
        item
        for item in report.issues
        if item.severity.value == "error"
    ]
    if not error_issues:
        return False

    has_claim_issue = any(
        item.code in _CLAIM_SPECIFIC_CODES
        for item in error_issues
    )
    has_claim_relation_issue = any(
        (
            item.code
            in {
                IssueCode.RELATION_SOURCE_TYPE_MISMATCH,
                IssueCode.RELATION_TARGET_TYPE_MISMATCH,
            }
            and item.relation in _CLAIM_RELATIONS
        )
        for item in error_issues
    )

    return has_claim_issue and has_claim_relation_issue


# These issue codes require a structural migration that the current
# KnowledgeGraphPatch operation set cannot represent safely.
SEMANTIC_PATCH_UNSUPPORTED_CODES = {
    IssueCode.CLAIM_LIKE_ENTITY,
}


def requires_complete_reextract(
    report: ValidationReport,
) -> bool:
    return bool(
        report.codes() & SEMANTIC_PATCH_UNSUPPORTED_CODES
    )


LOSSLESS_CODES = {
    IssueCode.DUPLICATE_NODE_ID,
    IssueCode.INVALID_MEASURED_FOR_COUNT,
    IssueCode.MEASURED_FOR_TARGET_MISMATCH,
    IssueCode.MISSING_MEASUREMENT_GROUP_EDGE,
    IssueCode.UNEXPECTED_MEASUREMENT_GROUP_EDGE,
    IssueCode.SINGLETON_MEASUREMENT_GROUP,
    IssueCode.DUPLICATE_MEASUREMENT_GROUP_MEMBER,
}


def decide_recovery(
    *,
    report: ValidationReport,
    normalization_attempted: bool,
    patch_attempts: int,
    micro_reextract_attempts: int,
    post_micro_patch_attempts: int,
    split_depth: int,
    source_tokens: int,
    max_patch_attempts: int,
    max_micro_reextract_attempts: int,
    max_post_micro_patch_attempts: int,
    micro_reextract_max_source_tokens: int,
    max_split_depth: int,
    min_rechunk_source_tokens: int,
    isolated_rechunk_threshold: int,
    issue_family_rechunk_threshold: int,
    undefined_endpoint_rechunk_threshold: int,
) -> RecoveryDecision:
    codes = tuple(sorted(item.value for item in report.codes()))
    if report.valid:
        return RecoveryDecision(RecoveryAction.ACCEPT, "No validation errors.", codes)

    if not normalization_attempted and report.codes() & LOSSLESS_CODES:
        return RecoveryDecision(
            RecoveryAction.NORMALIZE,
            "At least one issue can be normalized without scientific inference.",
            codes,
        )

    cannot_rechunk_safely = (
        split_depth >= max_split_depth
        or source_tokens <= min_rechunk_source_tokens
    )

    if cannot_rechunk_safely:
        # ---------------------------------------------------------
        # Phase 1: constrained semantic patch before micro-reextract
        # ---------------------------------------------------------
        if (
            micro_reextract_attempts == 0
            and patch_attempts < max_patch_attempts
        ):
            return RecoveryDecision(
                RecoveryAction.SEMANTIC_PATCH,
                (
                    "The chunk cannot be safely split; "
                    "attempt a constrained pre-micro patch."
                ),
                codes,
            )

        # ---------------------------------------------------------
        # Phase 2: one-shot micro re-extraction
        # ---------------------------------------------------------
        if (
            source_tokens
            <= micro_reextract_max_source_tokens
            and micro_reextract_attempts
            < max_micro_reextract_attempts
        ):
            return RecoveryDecision(
                RecoveryAction.MICRO_REEXTRACT,
                (
                    "Pre-micro semantic patch attempts were exhausted "
                    "for a small unsplittable source leaf."
                ),
                codes,
            )

        # ---------------------------------------------------------
        # Phase 2b: one bounded capability-aware complete re-extract retry.
        #
        # Residual families routed here need whole-subgraph reconstruction
        # more than another local semantic patch:
        #   (a) pure common missing-node endpoint cluster;
        #   (b) dominant missing-node cluster inside a mixed residual;
        #   (c) semantic-patch-unsupported collection migration;
        #   (d) coupled claim/relation subgraph.
        # ---------------------------------------------------------
        if (
            max_micro_reextract_attempts > 0
            and micro_reextract_attempts == max_micro_reextract_attempts
            and post_micro_patch_attempts == 0
            and (
                has_common_undefined_endpoint_cluster(report)
                or has_dominant_undefined_endpoint_cluster(report)
                or requires_complete_reextract(report)
                or has_coupled_claim_subgraph_residual(report)
            )
        ):
            if requires_complete_reextract(report):
                retry_reason = (
                    "The first micro-reextract left an issue that the current "
                    "semantic patch cannot represent safely; allow one bounded "
                    "complete micro-reextract retry."
                )
            elif has_coupled_claim_subgraph_residual(report):
                retry_reason = (
                    "The first micro-reextract left a coupled claim subgraph "
                    "residual; allow one bounded complete micro-reextract "
                    "retry to rebuild the claim/relation subgraph as a unit."
                )
            elif has_dominant_undefined_endpoint_cluster(report):
                retry_reason = (
                    "The first micro-reextract left a dominant missing-node "
                    "cluster inside a mixed residual; allow one bounded "
                    "targeted complete micro-reextract retry."
                )
            else:
                retry_reason = (
                    "The first micro-reextract left only a common undefined "
                    "endpoint cluster; allow one bounded targeted complete "
                    "micro-reextract retry."
                )
            return RecoveryDecision(
                RecoveryAction.MICRO_REEXTRACT,
                retry_reason,
                codes,
            )

        # ---------------------------------------------------------
        # Phase 3: patch small residual errors left by micro-reextract
        # ---------------------------------------------------------
        if (
            micro_reextract_attempts > 0
            and post_micro_patch_attempts
            < max_post_micro_patch_attempts
        ):
            return RecoveryDecision(
                RecoveryAction.SEMANTIC_PATCH,
                (
                    "Micro-reextract completed but left a small "
                    "strict-validation residual; attempt one "
                    "post-micro constrained patch."
                ),
                codes,
            )

        # ---------------------------------------------------------
        # Terminal state
        # ---------------------------------------------------------
        return RecoveryDecision(
            RecoveryAction.QUARANTINE,
            (
                "Pre-micro patch, micro-reextract, and "
                "post-micro patch budgets were exhausted "
                "and the chunk cannot be split safely."
            ),
            codes,
        )
    
    isolated_count = report.count(IssueCode.ISOLATED_NODE)
    undefined_count = (
        report.count(IssueCode.UNDEFINED_EDGE_SOURCE)
        + report.count(IssueCode.UNDEFINED_EDGE_TARGET)
    )

    if isolated_count >= isolated_rechunk_threshold:
        return RecoveryDecision(
            RecoveryAction.RECHUNK,
            f"Graph assembly failure: {isolated_count} isolated nodes.",
            codes,
        )

    if report.family_count() >= issue_family_rechunk_threshold:
        return RecoveryDecision(
            RecoveryAction.RECHUNK,
            f"Graph contains {report.family_count()} independent issue families.",
            codes,
        )

    if undefined_count >= undefined_endpoint_rechunk_threshold:
        return RecoveryDecision(
            RecoveryAction.RECHUNK,
            f"Graph contains {undefined_count} undefined edge endpoints.",
            codes,
        )

    if patch_attempts < max_patch_attempts:
        return RecoveryDecision(
            RecoveryAction.SEMANTIC_PATCH,
            "The remaining issue set is small enough for a constrained patch.",
            codes,
        )

    return RecoveryDecision(
        RecoveryAction.RECHUNK,
        "Constrained patch attempts were exhausted.",
        codes,
    )
