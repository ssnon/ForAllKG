from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from pydantic import ValidationError

from dac_her.chunking import ChunkSpec, count_tokens
from dac_her.draft_schema import KnowledgeGraphDraft
from dac_her.extraction_domain import ExtractionDomainAdapter
from dac_her.extraction_policy import ExtractionPolicy
from dac_her.domains.extraction_registry import get_extraction_adapter
from dac_her.llm_openrouter import OpenRouterLLM
from dac_her.lossless_normalization import normalize_knowledge_graph_payload
from dac_her.prompts import build_extraction_prompt
from dac_her.recovery_policy import RecoveryAction, decide_recovery
from dac_her.schemas import KnowledgeGraph
from dac_her.semantic_patch import PatchRejected, apply_semantic_patch
from dac_her.semantic_patch_prompts import (
    PATCH_SYSTEM_PROMPT,
    build_semantic_patch_prompt,
)
from dac_her.semantic_patch_schema import KnowledgeGraphPatch
from dac_her.strict_validation import (
    ValidationContext,
    finalize_draft,
    validate_draft,
)
from dac_her.validation import validate_graph_provenance
from dac_her.validation_issues import ValidationReport
from dac_her.vocab_registry import VocabularyRegistry
from dac_her.micro_reextract_prompts import (
    MICRO_REEXTRACT_SYSTEM_PROMPT,
    build_micro_reextract_prompt,
)

def chunk_output_path(chunk: ChunkSpec, chunk_output_dir: str | Path) -> Path:
    safe_chunk_id = chunk.chunk_id.replace(":", "__")
    return Path(chunk_output_dir) / f"{safe_chunk_id}.json"


def is_truncation_error(error: Exception, usage: dict[str, Any]) -> bool:
    message = str(error).lower()
    finish_reason = usage.get("finish_reason")
    output_tokens = usage.get("output_tokens")
    max_tokens = usage.get("max_completion_tokens")

    if finish_reason == "length":
        return True
    if "eof while parsing" in message or "truncated" in message:
        return True
    return (
        isinstance(output_tokens, int)
        and isinstance(max_tokens, int)
        and output_tokens >= max_tokens
    )


def load_existing_result(
    *,
    chunk: ChunkSpec,
    output_path: str | Path,
) -> KnowledgeGraph | None:
    path = Path(output_path)
    if not path.exists():
        return None
    try:
        result = KnowledgeGraph.model_validate_json(path.read_text(encoding="utf-8"))
        validate_graph_provenance(
            result,
            paper_id=chunk.paper_id,
            chunk_id=chunk.chunk_id,
            section=chunk.section,
            document_id=chunk.document_id,
            document_role=chunk.document_role,
            page_ids=chunk.page_ids,
            asset_ids=chunk.asset_ids,
        )
        return result
    except Exception:
        return None


def _write_json(path: Path, payload: Any) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True),
        encoding="utf-8",
    )
    return path


def _write_report(path: Path, report: ValidationReport) -> Path:
    return _write_json(path, report.model_dump(mode="json"))


def _context(chunk: ChunkSpec) -> ValidationContext:
    return ValidationContext(
        paper_id=chunk.paper_id,
        chunk_id=chunk.chunk_id,
        section=chunk.section,
        document_id=chunk.document_id,
        document_role=chunk.document_role,
        page_ids=chunk.page_ids,
        asset_ids=chunk.asset_ids,
    )


def _enforce_chunk_metadata(
    draft: KnowledgeGraphDraft,
    *,
    chunk: ChunkSpec,
) -> KnowledgeGraphDraft:
    """Restore authoritative control-plane metadata from ChunkSpec."""
    payload = draft.model_dump()
    authoritative = {
        "paper_id": chunk.paper_id,
        "chunk_id": chunk.chunk_id,
        "section": chunk.section,
        "document_id": chunk.document_id,
        "document_role": chunk.document_role,
        "page_ids": list(chunk.page_ids),
        "asset_ids": list(chunk.asset_ids),
    }
    for key, value in authoritative.items():
        if key in payload:
            payload[key] = value
    return KnowledgeGraphDraft.model_validate(payload)


def _domain_gate(
    draft: KnowledgeGraphDraft,
    *,
    extraction_adapter: ExtractionDomainAdapter,
) -> KnowledgeGraphDraft:
    """Canonicalize declared aliases, then fail closed on true drift."""
    draft = extraction_adapter.normalize_draft_vocabulary(draft)
    extraction_adapter.validate_draft_vocabulary(draft)
    return draft


def _base_record(chunk: ChunkSpec) -> dict[str, Any]:
    return {
        "paper_id": chunk.paper_id,
        "chunk_id": chunk.chunk_id,
        "section": chunk.section,
        "document_id": chunk.document_id,
        "document_role": chunk.document_role,
        "page_ids": list(chunk.page_ids),
        "asset_ids": list(chunk.asset_ids),
        "chunk_index": chunk.index,
        "split_depth": chunk.split_depth,
        "source_characters": len(chunk.core_text),
        "source_tokens_estimated": count_tokens(chunk.core_text),
    }


def _success_record(
    *,
    chunk: ChunkSpec,
    graph: KnowledgeGraph,
    output_path: Path,
    acceptance_mode: str,
    attempt_usages: list[dict[str, Any]],
    vocabulary_issues: list[Any],
    generation_attempts: int,
    normalization_path: Path | None,
    normalization_count: int,
    patch_paths: list[Path],
    patch_operation_count: int,
    patch_attempts: int,
    micro_reextract_attempts: int,
    post_micro_patch_attempts: int,
) -> dict[str, Any]:
    usage = dict(attempt_usages[-1] if attempt_usages else {})
    output_tokens = usage.get("output_tokens")
    max_tokens = usage.get("max_completion_tokens")
    utilization = (
        output_tokens / max_tokens
        if isinstance(output_tokens, int) and isinstance(max_tokens, int) and max_tokens
        else None
    )
    return {
        "status": "success",
        **_base_record(chunk),
        "acceptance_mode": acceptance_mode,
        "generation_attempts": generation_attempts,
        "patch_attempts": patch_attempts,
        "micro_reextract_attempts": micro_reextract_attempts,
        "post_micro_patch_attempts": post_micro_patch_attempts,
        "api_attempts": len(attempt_usages),
        "output_path": str(output_path),
        "utilization": utilization,
        "node_count": len(graph.all_node_ids()),
        "edge_count": len(graph.edges),
        "normalization_count": normalization_count,
        "normalization_path": str(normalization_path) if normalization_path else None,
        "patch_operation_count": patch_operation_count,
        "patch_paths": [str(path) for path in patch_paths],
        "unregistered_vocabulary_count": len(vocabulary_issues),
        "vocabulary_issues": [item.to_dict() for item in vocabulary_issues],
        "attempt_usages": attempt_usages,
        **usage,
    }


def _finalize_and_save(
    *,
    draft: KnowledgeGraphDraft,
    chunk: ChunkSpec,
    output_path: Path,
    experiment_registry: VocabularyRegistry,
    metric_registry: VocabularyRegistry,
) -> tuple[KnowledgeGraph | None, list[Any], ValidationReport]:
    finalized = finalize_draft(
        draft=draft,
        context=_context(chunk),
        experiment_registry=experiment_registry,
        metric_registry=metric_registry,
    )
    if finalized.graph is not None:
        _write_json(output_path, finalized.graph.model_dump())
    return finalized.graph, finalized.vocabulary_issues, finalized.report


def extract_one_chunk(
    *,
    chunk: ChunkSpec,
    model: str,
    provider: str | None,
    policy: ExtractionPolicy,
    chunk_output_dir: str | Path,
    debug_dir: str | Path,
    experiment_registry: VocabularyRegistry,
    metric_registry: VocabularyRegistry,
    vocabulary_context: str,
    force: bool = False,
    extraction_adapter: ExtractionDomainAdapter | None = None,
) -> dict[str, Any]:
    extraction_adapter = extraction_adapter or get_extraction_adapter("dac_her")
    output_path = chunk_output_path(chunk, chunk_output_dir)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    debug_dir = Path(debug_dir)
    debug_dir.mkdir(parents=True, exist_ok=True)
    run_dir = debug_dir.parent
    candidate_dir = run_dir / "candidates"
    validation_dir = run_dir / "validation"
    normalization_dir = run_dir / "normalizations"
    patch_dir = run_dir / "patches"
    quarantine_dir = run_dir / "quarantine"
    for directory in (
        candidate_dir,
        validation_dir,
        normalization_dir,
        patch_dir,
        quarantine_dir,
    ):
        directory.mkdir(parents=True, exist_ok=True)

    if not force:
        existing = load_existing_result(chunk=chunk, output_path=output_path)
        if existing is not None:
            return {
                "status": "skipped",
                **_base_record(chunk),
                "acceptance_mode": "cached_strict",
                "output_path": str(output_path),
                "node_count": len(existing.all_node_ids()),
                "edge_count": len(existing.edges),
            }

    safe_chunk_id = chunk.chunk_id.replace(":", "__")
    attempt_usages: list[dict[str, Any]] = []
    generation_feedback: str | None = None
    draft: KnowledgeGraphDraft | None = None

    # Full graph regeneration is reserved for malformed/node-schema output or
    # truncation. Cross-graph semantic errors are handled after a draft exists.
    for generation_attempt in range(policy.max_generation_attempts):
        llm = OpenRouterLLM(
            model=model,
            provider=provider,
            reproducible=False,
            zdr=True,
        )
        raw_debug_path = debug_dir / f"{safe_chunk_id}__generation_{generation_attempt}.json"
        try:
            draft = llm.generate_structured(
                system_prompt=extraction_adapter.system_prompt,
                prompt=build_extraction_prompt(
                    paper_id=chunk.paper_id,
                    chunk_id=chunk.chunk_id,
                    document_id=chunk.document_id,
                    document_role=chunk.document_role,
                    section=chunk.section,
                    page_ids=chunk.page_ids,
                    asset_ids=chunk.asset_ids,
                    asset_context=chunk.asset_context,
                    vocabulary_context=vocabulary_context,
                    left_context=chunk.left_context,
                    core_text=chunk.core_text,
                    right_context=chunk.right_context,
                    validation_feedback=generation_feedback,
                ),
                response_model=KnowledgeGraphDraft,
                temperature=0.0,
                max_tokens=policy.max_completion_tokens,
                debug_path=raw_debug_path,
            )
            draft = _enforce_chunk_metadata(
                draft,
                chunk=chunk,
            )
            _domain_gate(
                draft,
                extraction_adapter=extraction_adapter,
            )
            usage = dict(llm.last_call_metadata or {})
            usage["max_completion_tokens"] = policy.max_completion_tokens
            usage["call_kind"] = "graph_generation"
            usage["generation_attempt"] = generation_attempt
            attempt_usages.append(usage)
            _write_json(
                candidate_dir / f"{safe_chunk_id}__generation_{generation_attempt}.json",
                draft.model_dump(),
            )
            break
        except Exception as error:
            usage = dict(llm.last_call_metadata or {})
            usage["max_completion_tokens"] = policy.max_completion_tokens
            usage["call_kind"] = "graph_generation"
            usage["generation_attempt"] = generation_attempt
            attempt_usages.append(usage)

            if is_truncation_error(error, usage):
                if generation_attempt + 1 < policy.max_generation_attempts:
                    generation_feedback = (
                        "The previous response was truncated. Return a much smaller "
                        "complete graph containing only the highest-value facts in CORE_TEXT."
                    )
                    continue
                return {
                    "status": "truncated",
                    **_base_record(chunk),
                    "error_type": type(error).__name__,
                    "error_message": str(error),
                    "debug_path": str(raw_debug_path),
                    "attempt_usages": attempt_usages,
                    **usage,
                }

            if generation_attempt + 1 < policy.max_generation_attempts:
                if (
                    isinstance(error, ValueError)
                    and "Extraction-domain vocabulary violation" in str(error)
                ):
                    generation_feedback = (
                        "The previous response crossed the active scientific-domain "
                        "vocabulary. Use only the exact entity and relation names "
                        "defined by the SYSTEM prompt. Experiment, Calculation, "
                        "Measurement, and claim objects must use their dedicated "
                        "top-level collections rather than entities[]. "
                        f"Error: {error}"
                    )
                else:
                    generation_feedback = (
                        "The previous response did not satisfy the node-level JSON "
                        f"schema. Return a complete corrected graph. Error: {error}"
                    )
                continue

            quarantine_path = quarantine_dir / f"{safe_chunk_id}.json"
            _write_json(
                quarantine_path,
                {
                    "reason": "draft_schema_generation_exhausted",
                    "error_type": type(error).__name__,
                    "error_message": str(error),
                    "debug_path": str(raw_debug_path),
                },
            )
            return {
                "status": "quarantined",
                **_base_record(chunk),
                "recovery_reason": "draft_schema_generation_exhausted",
                "error_type": type(error).__name__,
                "error_message": str(error),
                "quarantine_path": str(quarantine_path),
                "patch_attempts": 0,
                "micro_reextract_attempts": 0,
                "post_micro_patch_attempts": 0,
                "attempt_usages": attempt_usages,
                **usage,
            }

    if draft is None:  # pragma: no cover
        raise RuntimeError("Generation loop ended without a draft or terminal record.")

    normalization_attempted = False
    normalization_path: Path | None = None
    normalization_count = 0
    patch_paths: list[Path] = []
    patch_operation_count = 0

    report = validate_draft(draft)
    _write_report(validation_dir / f"{safe_chunk_id}__raw.json", report)

    graph, vocabulary_issues, final_report = _finalize_and_save(
        draft=draft,
        chunk=chunk,
        output_path=output_path,
        experiment_registry=experiment_registry,
        metric_registry=metric_registry,
    )
    if graph is not None:
        return _success_record(
            chunk=chunk,
            graph=graph,
            output_path=output_path,
            acceptance_mode="accepted_raw",
            attempt_usages=attempt_usages,
            vocabulary_issues=vocabulary_issues,
            generation_attempts=len([item for item in attempt_usages if item.get("call_kind") == "graph_generation"]),
            normalization_path=None,
            normalization_count=0,
            patch_paths=[],
            patch_operation_count=0,
            patch_attempts=0,
            micro_reextract_attempts=0,
            post_micro_patch_attempts=0,
        )
    if report.valid and not final_report.valid:
        report = final_report

    # Lossless normalization is attempted once. It never drops isolated nodes
    # or claims and never guesses a scientific endpoint.
    normalization = normalize_knowledge_graph_payload(
        draft.model_dump(),
        issues=report.issues,
    )
    normalization_attempted = True
    normalization_count = len(normalization.operations)
    normalization_path = normalization_dir / f"{safe_chunk_id}.json"
    _write_json(
        normalization_path,
        {
            **normalization.to_dict(),
            "payload": normalization.payload,
        },
    )
    if normalization.operations:
        draft = KnowledgeGraphDraft.model_validate(normalization.payload)
        report = validate_draft(draft)
        _write_report(validation_dir / f"{safe_chunk_id}__normalized.json", report)
        graph, vocabulary_issues, final_report = _finalize_and_save(
            draft=draft,
            chunk=chunk,
            output_path=output_path,
            experiment_registry=experiment_registry,
            metric_registry=metric_registry,
        )
        if graph is not None:
            return _success_record(
                chunk=chunk,
                graph=graph,
                output_path=output_path,
                acceptance_mode="accepted_normalized",
                attempt_usages=attempt_usages,
                vocabulary_issues=vocabulary_issues,
                generation_attempts=len([item for item in attempt_usages if item.get("call_kind") == "graph_generation"]),
                normalization_path=normalization_path,
                normalization_count=normalization_count,
                patch_paths=[],
                patch_operation_count=0,
            patch_attempts=0,
            micro_reextract_attempts=0,
            post_micro_patch_attempts=0,
            )
        if report.valid and not final_report.valid:
            report = final_report

    patch_feedback: str | None = None
    patch_attempts = 0
    micro_reextract_attempts = 0
    post_micro_patch_attempts = 0

    while True:
        decision = decide_recovery(
            report=report,
            normalization_attempted=(
                normalization_attempted
            ),
            patch_attempts=patch_attempts,
            micro_reextract_attempts=(
                micro_reextract_attempts
            ),
            post_micro_patch_attempts=(
                post_micro_patch_attempts
            ),
            split_depth=chunk.split_depth,
            source_tokens=count_tokens(
                chunk.core_text
            ),
            max_patch_attempts=(
                policy.max_patch_attempts
            ),
            max_micro_reextract_attempts=(
                policy.max_micro_reextract_attempts
            ),
            max_post_micro_patch_attempts=(
                policy.max_post_micro_patch_attempts
            ),
            micro_reextract_max_source_tokens=(
                policy.micro_reextract_max_source_tokens
            ),
            max_split_depth=policy.max_split_depth,
            min_rechunk_source_tokens=(
                policy.min_rechunk_source_tokens
            ),
            isolated_rechunk_threshold=(
                policy
                .semantic_rechunk_isolated_threshold
            ),
            issue_family_rechunk_threshold=(
                policy
                .semantic_rechunk_issue_family_threshold
            ),
            undefined_endpoint_rechunk_threshold=(
                policy
                .semantic_rechunk_undefined_endpoint_threshold
            ),
        )

        if decision.action == RecoveryAction.SEMANTIC_PATCH:
            is_post_micro_patch = (
                micro_reextract_attempts > 0
            )

            if is_post_micro_patch:
                patch_index = post_micro_patch_attempts
                patch_phase = "post_micro"
                patch_stem = (
                    f"{safe_chunk_id}"
                    f"__post_micro_patch_{patch_index}"
                )
            else:
                patch_index = patch_attempts
                patch_phase = "pre_micro"
                patch_stem = (
                    f"{safe_chunk_id}"
                    f"__patch_{patch_index}"
                )

            llm = OpenRouterLLM(
                model=model,
                provider=provider,
                reproducible=False,
                zdr=True,
            )
            patch_debug_path = (
                debug_dir / f"{patch_stem}.json"
            )
            usage_recorded = False

            try:
                patch = llm.generate_structured(
                    system_prompt=extraction_adapter.patch_system_prompt,
                    prompt=build_semantic_patch_prompt(
                        paper_id=chunk.paper_id,
                        chunk_id=chunk.chunk_id,
                        document_id=chunk.document_id,
                        document_role=chunk.document_role,
                        page_ids=chunk.page_ids,
                        asset_ids=chunk.asset_ids,
                        core_text=chunk.core_text,
                        asset_context=chunk.asset_context,
                        graph_payload=draft.model_dump(),
                        report=report,
                        previous_patch_feedback=(
                            patch_feedback
                        ),
                    ),
                    response_model=KnowledgeGraphPatch,
                    temperature=0.0,
                    max_tokens=(
                        policy.patch_completion_tokens
                    ),
                    debug_path=patch_debug_path,
                )

                usage = dict(
                    llm.last_call_metadata or {}
                )
                usage["max_completion_tokens"] = (
                    policy.patch_completion_tokens
                )
                usage["call_kind"] = "semantic_patch"
                usage["patch_attempt"] = patch_index
                usage["patch_phase"] = patch_phase
                attempt_usages.append(usage)
                usage_recorded = True

                patch_path = (
                    patch_dir / f"{patch_stem}.json"
                )
                _write_json(
                    patch_path,
                    patch.model_dump(mode="json"),
                )
                patch_paths.append(patch_path)

                applied = apply_semantic_patch(
                    draft=draft,
                    patch=patch,
                    report=report,
                    max_operations=(
                        policy.max_patch_operations
                    ),
                    allow_destructive=(
                        policy.allow_destructive_patches
                    ),
                )
                patch_operation_count += (
                    applied.operation_count
                )
                draft = _enforce_chunk_metadata(
                    applied.draft,
                    chunk=chunk,
                )

                post_patch_normalization = (
                    normalize_knowledge_graph_payload(
                        draft.model_dump(),
                        issues=report.issues,
                    )
                )
                if post_patch_normalization.operations:
                    draft = (
                        KnowledgeGraphDraft.model_validate(
                            post_patch_normalization.payload
                        )
                    )
                    draft = _enforce_chunk_metadata(
                        draft,
                        chunk=chunk,
                    )
                    normalization_count += len(
                        post_patch_normalization.operations
                    )

                _domain_gate(
                    draft,
                    extraction_adapter=extraction_adapter,
                )
                report = validate_draft(draft)

                validation_suffix = (
                    f"after_post_micro_patch_"
                    f"{patch_index}"
                    if is_post_micro_patch
                    else f"after_patch_{patch_index}"
                )
                _write_report(
                    validation_dir
                    / (
                        f"{safe_chunk_id}"
                        f"__{validation_suffix}.json"
                    ),
                    report,
                )

                (
                    graph,
                    vocabulary_issues,
                    final_report,
                ) = _finalize_and_save(
                    draft=draft,
                    chunk=chunk,
                    output_path=output_path,
                    experiment_registry=(
                        experiment_registry
                    ),
                    metric_registry=metric_registry,
                )

                if is_post_micro_patch:
                    post_micro_patch_attempts += 1
                else:
                    patch_attempts += 1

                if graph is not None:
                    return _success_record(
                        chunk=chunk,
                        graph=graph,
                        output_path=output_path,
                        acceptance_mode=(
                            "accepted_post_micro_patch"
                            if is_post_micro_patch
                            else "accepted_patched"
                        ),
                        attempt_usages=attempt_usages,
                        vocabulary_issues=(
                            vocabulary_issues
                        ),
                        generation_attempts=len([
                            item
                            for item in attempt_usages
                            if item.get("call_kind")
                            == "graph_generation"
                        ]),
                        normalization_path=(
                            normalization_path
                        ),
                        normalization_count=(
                            normalization_count
                        ),
                        patch_paths=patch_paths,
                        patch_operation_count=(
                            patch_operation_count
                        ),
                        patch_attempts=patch_attempts,
                        micro_reextract_attempts=(
                            micro_reextract_attempts
                        ),
                        post_micro_patch_attempts=(
                            post_micro_patch_attempts
                        ),
                    )

                if (
                    report.valid
                    and not final_report.valid
                ):
                    report = final_report

                patch_feedback = (
                    "The applied "
                    f"{patch_phase} patch did not "
                    "produce a strict-valid graph. "
                    "Remaining issues: "
                    f"{[item.model_dump(mode='json') for item in report.issues]}"
                )
                continue

            except (
                PatchRejected,
                ValidationError,
                ValueError,
            ) as error:
                usage = dict(
                    llm.last_call_metadata or {}
                )
                usage["max_completion_tokens"] = (
                    policy.patch_completion_tokens
                )
                usage["call_kind"] = "semantic_patch"
                usage["patch_attempt"] = patch_index
                usage["patch_phase"] = patch_phase
                usage["error_type"] = (
                    type(error).__name__
                )
                usage["error_message"] = str(error)

                if not usage_recorded:
                    attempt_usages.append(usage)

                if is_post_micro_patch:
                    post_micro_patch_attempts += 1
                else:
                    patch_attempts += 1

                patch_feedback = (
                    f"{type(error).__name__}: {error}"
                )
                continue

        if (
            decision.action
            == RecoveryAction.MICRO_REEXTRACT
        ):
            llm = OpenRouterLLM(
                model=model,
                provider=provider,
                reproducible=False,
                zdr=True,
            )

            micro_index = micro_reextract_attempts

            micro_debug_path = (
                debug_dir
                / (
                    f"{safe_chunk_id}"
                    f"__micro_reextract_{micro_index}.json"
                )
            )

            try:
                micro_draft = llm.generate_structured(
                    system_prompt=(
                        extraction_adapter.micro_reextract_system_prompt
                    ),
                    prompt=build_micro_reextract_prompt(
                        paper_id=chunk.paper_id,
                        chunk_id=chunk.chunk_id,
                        document_id=chunk.document_id,
                        document_role=chunk.document_role,
                        section=chunk.section,
                        page_ids=chunk.page_ids,
                        asset_ids=chunk.asset_ids,
                        core_text=chunk.core_text,
                        left_context=chunk.left_context,
                        right_context=chunk.right_context,
                        asset_context=chunk.asset_context,
                        graph_payload=draft.model_dump(),
                        report=report,
                    ),
                    response_model=KnowledgeGraphDraft,
                    temperature=0.0,
                    max_tokens=(
                        policy.max_completion_tokens
                    ),
                    debug_path=micro_debug_path,
                )

                micro_draft = _enforce_chunk_metadata(
                    micro_draft,
                    chunk=chunk,
                )
                _domain_gate(
                    micro_draft,
                    extraction_adapter=extraction_adapter,
                )

                usage = dict(
                    llm.last_call_metadata or {}
                )
                usage["max_completion_tokens"] = (
                    policy.max_completion_tokens
                )
                usage["call_kind"] = (
                    "micro_reextract"
                )
                usage["micro_reextract_attempt"] = (
                    micro_index
                )
                attempt_usages.append(usage)

                micro_reextract_attempts += 1

                _write_json(
                    candidate_dir
                    / (
                        f"{safe_chunk_id}"
                        f"__micro_reextract_{micro_index}.json"
                    ),
                    micro_draft.model_dump(),
                )

                micro_report = validate_draft(
                    micro_draft
                )

                micro_normalization = (
                    normalize_knowledge_graph_payload(
                        micro_draft.model_dump(),
                        issues=micro_report.issues,
                    )
                )

                if micro_normalization.operations:
                    micro_draft = (
                        KnowledgeGraphDraft.model_validate(
                            micro_normalization.payload
                        )
                    )
                    micro_draft = _enforce_chunk_metadata(
                        micro_draft,
                        chunk=chunk,
                    )
                    normalization_count += len(
                        micro_normalization.operations
                    )

                _domain_gate(
                    micro_draft,
                    extraction_adapter=extraction_adapter,
                )
                report = validate_draft(
                    micro_draft
                )

                _write_report(
                    validation_dir
                    / (
                        f"{safe_chunk_id}"
                        f"__after_micro_reextract_"
                        f"{micro_index}.json"
                    ),
                    report,
                )

                graph, vocabulary_issues, final_report = (
                    _finalize_and_save(
                        draft=micro_draft,
                        chunk=chunk,
                        output_path=output_path,
                        experiment_registry=(
                            experiment_registry
                        ),
                        metric_registry=metric_registry,
                    )
                )

                draft = micro_draft
                patch_feedback = None

                if graph is not None:
                    return _success_record(
                        chunk=chunk,
                        graph=graph,
                        output_path=output_path,
                        acceptance_mode=(
                            "accepted_micro_reextract"
                        ),
                        attempt_usages=attempt_usages,
                        vocabulary_issues=(
                            vocabulary_issues
                        ),
                        generation_attempts=len([
                            item
                            for item in attempt_usages
                            if item.get("call_kind")
                            == "graph_generation"
                        ]),
                        normalization_path=(
                            normalization_path
                        ),
                        normalization_count=(
                            normalization_count
                        ),
                        patch_paths=patch_paths,
                        patch_operation_count=(
                            patch_operation_count
                        ),
                        patch_attempts=patch_attempts,
                        micro_reextract_attempts=(
                            micro_reextract_attempts
                        ),
                        post_micro_patch_attempts=(
                            post_micro_patch_attempts
                        ),
                    )

                if (
                    report.valid
                    and not final_report.valid
                ):
                    report = final_report

                continue

            except (
                ValidationError,
                ValueError,
            ) as error:
                usage = dict(
                    llm.last_call_metadata or {}
                )
                usage[
                    "max_completion_tokens"
                ] = policy.max_completion_tokens
                usage["call_kind"] = (
                    "micro_reextract"
                )
                usage[
                    "micro_reextract_attempt"
                ] = micro_index
                usage["error_type"] = (
                    type(error).__name__
                )
                usage["error_message"] = str(error)

                attempt_usages.append(usage)
                micro_reextract_attempts += 1

                if (
                    isinstance(error, ValueError)
                    and "Extraction-domain vocabulary violation" in str(error)
                ):
                    patch_feedback = (
                        "The micro-reextract was rejected by the active domain "
                        "vocabulary gate. Keep the current source-grounded graph, "
                        "repair only the reported validation issues, and use exact "
                        f"domain relation/entity names. Rejection: {error}"
                    )

                continue
            
        if decision.action == RecoveryAction.RECHUNK:
            return {
                "status": "rechunk",
                **_base_record(chunk),
                "recovery_reason": decision.reason,
                "validation_issue_counts": report.code_counts(),
                "validation_issues": [item.model_dump(mode="json") for item in report.issues],
                "normalization_count": normalization_count,
                "normalization_path": str(normalization_path) if normalization_path else None,
                "patch_attempts": patch_attempts,
                "micro_reextract_attempts": (
                    micro_reextract_attempts
                ),
                "post_micro_patch_attempts": (
                    post_micro_patch_attempts
                ),
                "patch_paths": [str(path) for path in patch_paths],
                "attempt_usages": attempt_usages,
            }

        quarantine_path = quarantine_dir / f"{safe_chunk_id}.json"
        _write_json(
            quarantine_path,
            {
                "reason": decision.reason,
                "graph_payload": draft.model_dump(),
                "validation_report": report.model_dump(mode="json"),
                "normalization_path": str(normalization_path) if normalization_path else None,
                "patch_paths": [str(path) for path in patch_paths],
            },
        )
        return {
            "status": "quarantined",
            **_base_record(chunk),
            "recovery_reason": decision.reason,
            "validation_issue_counts": report.code_counts(),
            "validation_issues": [item.model_dump(mode="json") for item in report.issues],
            "normalization_count": normalization_count,
            "normalization_path": str(normalization_path) if normalization_path else None,
            "patch_attempts": patch_attempts,
            "micro_reextract_attempts": (
                micro_reextract_attempts
            ),
            "post_micro_patch_attempts": (
                post_micro_patch_attempts
            ),
            "patch_paths": [str(path) for path in patch_paths],
            "quarantine_path": str(quarantine_path),
            "attempt_usages": attempt_usages,
        }
