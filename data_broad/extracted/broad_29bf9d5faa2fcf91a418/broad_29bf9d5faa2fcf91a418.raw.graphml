<node id="paper_1">
  <data key="d17">Paper</data>
  <data key="d18">Surface-Dependent Intermediate Adsorption Modulation on Iridium-Modified Black Phosphorus Electrocatalysts for Efficient pH-Universal Water Splitting</data>
  <data key="d19">Paper reporting Ir-modified black phosphorus electrocatalysts for HER and OER.</data>
</node>
<node id="cat_ir_bp">
  <data key="d17">Catalyst</data>
  <data key="d18">Ir-modified black phosphorus electrocatalyst</data>
  <data key="d19">Heterostructured electrocatalyst consisting of nanosized iridium modifier and black phosphorus with optimized exposed surfaces.</data>
</node>
<node id="metal_ir">
  <data key="d17">Metal</data>
  <data key="d18">Iridium</data>
  <data key="d19">Nanosized Ir modifier introduced onto black phosphorus.</data>
</node>
<node id="support_bp">
  <data key="d17">Support</data>
  <data key="d18">Black phosphorus</data>
  <data key="d19">2D black phosphorus component of the Ir-modified catalyst.</data>
</node>
<node id="rxn_her">
  <data key="d17">Reaction</data>
  <data key="d18">Hydrogen evolution reaction</data>
  <data key="d19">Electrochemical hydrogen evolution reaction.</data>
</node>
<node id="rxn_oer">
  <data key="d17">Reaction</data>
  <data key="d18">Oxygen evolution reaction</data>
  <data key="d19">Electrochemical oxygen evolution reaction.</data>
</node>
<node id="state_optimized_surface">
  <data key="d17">StructuralState</data>
  <data key="d18">Optimized exposed catalyst surfaces</data>
  <data key="d19">Surface exposure state of the Ir-modified BP catalyst optimized toward electrolytes.</data>
</node>
<node id="ads_o_intermediates">
  <data key="d17">AdsorbateState</data>
  <data key="d18">Adsorbed oxygen intermediates</data>
  <data key="d19">Oxygen-containing intermediates involved in OER; pristine BP is described as binding them too strongly.</data>
</node>
<node id="ads_h_intermediate">
  <data key="d17">AdsorbateState</data>
  <data key="d18">Adsorbed hydrogen intermediate</data>
  <data key="d19">Hydrogen intermediate involved in HER; pristine BP is described as binding it too weakly.</data>
</node>
<node id="factor_adsorption_modulation">
  <data key="d17">MechanisticFactor</data>
  <data key="d18">Reaction-intermediate adsorption-energy modulation</data>
  <data key="d19">Modification of intermediate adsorption energies toward more favorable values.</data>
</node>
<node id="factor_electron_coupling">
  <data key="d17">MechanisticFactor</data>
  <data key="d18">Interfacial electron coupling</data>
  <data key="d19">Electron coupling promoted at the interface of the heterostructured catalyst.</data>
</node>
