<node id="paper_1">
  <data key="d17">Paper</data>
  <data key="d18">Synergistic Mechanism of Sub-Nanometric Ru Clusters Anchored on Tungsten Oxide Nanowires for High-Efficient Bifunctional Hydrogen Electrocatalysis</data>
