  <data key="d17">Paper</data>
  <data key="d18">A Universal Strategy to Design Superior Water-Splitting Electrocatalysts Based on Fast In Situ Reconstruction of Amorphous Nanofilm Precursors</data>
  <data key="d19"></data>
</node>
<node id="cat_scfp_nf">
  <data key="d17">Catalyst</data>
  <data key="d18">SCFP-NF bifunctional catalyst</data>
  <data key="d19">Precious-metal-free bifunctional water-splitting electrocatalyst consisting of an amorphous SrCo0.85Fe0.1P0.05O3−δ nanofilm precursor deposited on nickel foam and rapidly reconstructed in situ.</data>
</node>
