<node id="paper_broad_4127da7ec24cf0263479">
  <data key="d17">Paper</data>
  <data key="d18">Structural Self-Reconstruction of Catalysts in Electrocatalysis</data>
  <data key="d19">Account discussing structural self-reconstruction, true active sites, and mechanism changes in electrocatalysis.</data>
</node>
<node id="catalyst_electrocatalysts">
  <data key="d17">Catalyst</data>
  <data key="d18">Electrocatalysts</data>
  <data key="d19">Catalysts used for electrocatalytic reactions that may undergo structural and activity changes under reaction conditions.</data>
</node>
<node id="state_precatalyst">
  <data key="d17">StructuralState</data>
  <data key="d18">Precatalyst under nonreaction conditions</data>
  <data key="d19">The catalyst state under nonreaction conditions before drastic structural and activity self-change during electrocatalysis.</data>
</node>
<node id="state_true_catalyst">
  <data key="d17">StructuralState</data>
  <data key="d18">True catalyst under realistic reaction conditions</data>
  <data key="d19">Restructured active components present under realistic reaction conditions.</data>
</node>
<node id="factor_electro_derived_redox">
  <data key="d17">MechanisticFactor</data>
  <data key="d18">Electro-derived oxidation or reduction</data>
  <data key="d19">Electrochemical oxidation or reduction processes identified as a cause of catalyst structural self-reconstruction.</data>
</node>
<node id="environment_realistic_reaction_conditions">
  <data key="d17">InterfacialEnvironment</data>
  <data key="d18">Realistic reaction conditions</data>
  <data key="d19">Reaction-condition environment in which restructured active components are described as true catalysts.</data>
</node>
