<node id="calc_full_solvent_qm_md">
  <data key="d21">Calculation</data>
  <data key="d22">Full-solvent quantum mechanics molecular dynamics of the electrode–electrolyte interface</data>
  <data key="d26">quantum_mechanics_molecular_dynamics</data>
  <data key="d27">[]</data>
  <data key="d28">QM-based simulation with explicit solvent and applied voltage; reactive trajectories are generated for subsequent vibrational-density-of-states analysis.</data>
  <data key="d24">["calc_full_solvent_qm_md"]</data>
