  <data key="d17">Catalyst</data>
  <data key="d18">Support-free cobalt single-atom catalyst</data>
  <data key="d19">Catalyst produced by support-free pyrolysis of vitamin B12 and cobalt tetramethoxyphenylporphyrin; reported inactive for ORR.</data>
</node>
<node id="cat_support_assisted_sac">
  <data key="d17">Catalyst</data>
  <data key="d18">Support-assisted cobalt single-atom catalyst</data>
