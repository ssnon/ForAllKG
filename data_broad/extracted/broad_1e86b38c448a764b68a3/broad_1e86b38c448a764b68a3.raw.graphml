  <data key="d17">Reaction</data>
  <data key="d18">oxygen reduction reaction</data>
  <data key="d19">Oxygen reduction reaction catalyzed by the heterostructure.</data>
</node>
<node id="reaction_oer">
  <data key="d17">Reaction</data>
  <data key="d18">oxygen evolution reaction</data>
  <data key="d19">Oxygen evolution reaction catalyzed by the heterostructure.</data>
</node>
<node id="state_orthorhombic_cose2">
  <data key="d17">StructuralState</data>
  <data key="d18">orthorhombic CoSe2</data>
  <data key="d19">Initial orthorhombic phase of cobalt selenide.</data>
</node>
<node id="state_cubic_cose2">
  <data key="d17">StructuralState</data>
  <data key="d18">cubic CoSe2</data>
  <data key="d19">Cubic CoSe2 phase formed during phase transformation.</data>
</node>
