  <data key="d17">Paper</data>
  <data key="d18">Modulation of Phase Transition in Cobalt Selenide with Simultaneous Construction of Heterojunctions for Highly-Efficient Oxygen Electrocatalysis in Zinc-Air Battery</data>
  <data key="d19"></data>
</node>
<node id="cat_cose2_con_heterostructure">
  <data key="d17">Catalyst</data>
  <data key="d18">c-CoSe2/CoN heterostructure in hollow carbon cage</data>
  <data key="d19">Cubic CoSe2 and CoN heterostructure embedded in a hollow carbon cage for bifunctional oxygen electrocatalysis.</data>
</node>
<node id="metal_co">
  <data key="d17">Metal</data>
  <data key="d18">Co</data>
  <data key="d19">Cobalt component of the cobalt selenide and cobalt nitride catalyst.</data>
</node>
