</node>
<node id="claim_3">
  <data key="d17">MechanismClaim</data>
  <data key="d18">Conversion of general cobalt oxide to the CoO2 phase under OER conditions retards OER kinetics.</data>
  <data key="d28">phase_conversion_limitation</data>
