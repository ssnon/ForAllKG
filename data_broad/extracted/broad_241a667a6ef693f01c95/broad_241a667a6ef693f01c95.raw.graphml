<node id="paper_1">
  <data key="d17">Paper</data>
  <data key="d18">POPs-Based Single-Atom Catalysts for Sustainable Energy-Related Electrocatalysis</data>
  <data key="d19">Review of porous organic polymer-based single-atom catalysts for electrocatalytic energy conversion and storage reactions.</data>
</node>
<node id="catalyst_1">
  <data key="d17">Catalyst</data>
  <data key="d18">POPs-based single-atom catalysts</data>
  <data key="d19">Single-atom catalysts supported by porous organic polymers or POPs-derived nanocarbons.</data>
</node>
<node id="support_1">
  <data key="d17">Support</data>
  <data key="d18">Porous organic polymers</data>
  <data key="d19">Designable porous organic polymer platforms used to stabilize atomically dispersed metals and host single-atom catalysts.</data>
</node>
<node id="metal_1">
  <data key="d17">Metal</data>
  <data key="d18">Atomically dispersed metals</data>
  <data key="d19">Metal species stabilized as isolated atoms in POPs-based single-atom catalysts.</data>
</node>
<node id="active_site_1">
  <data key="d17">ActiveSite</data>
  <data key="d18">Atomically dispersed metal sites</data>
  <data key="d19">Single-atom catalytic sites hosted by porous organic polymer-based supports.</data>
</node>
<node id="state_1">
  <data key="d17">StructuralState</data>
  <data key="d18">Atomically dispersed metal configuration</data>
  <data key="d19">Structural state in which metals are atomically dispersed rather than present as larger metallic particles.</data>
</node>
<node id="environment_1">
  <data key="d17">InterfacialEnvironment</data>
  <data key="d18">Tunable local electronic environment</data>
  <data key="d19">Local electronic environment around the supported single-atom metal sites.</data>
</node>
<node id="factor_1">
  <data key="d17">MechanisticFactor</data>
  <data key="d18">Strong metal–support interaction</data>
  <data key="d19">Metal–support interaction identified as a factor for stabilizing atomically dispersed metals.</data>
</node>
<node id="factor_2">
  <data key="d17">MechanisticFactor</data>
  <data key="d18">Favorable electron and mass transport</data>
  <data key="d19">Electron and mass transport properties identified as relevant support characteristics for electrocatalysis.</data>
</node>
