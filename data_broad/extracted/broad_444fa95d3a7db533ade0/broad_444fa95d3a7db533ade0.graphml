  <data key="d21">MechanisticFactor</data>
  <data key="d22">Ni oxidation-state increase</data>
  <data key="d23">Increase in the Ni oxidation state during anodic OER, stated to contribute to OER performance.</data>
  <data key="d24">["factor_ni_oxidation_increase"]</data>
  <data key="d25">1</data>
</node>
