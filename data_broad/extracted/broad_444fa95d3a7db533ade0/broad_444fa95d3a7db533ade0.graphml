  <data key="d21">Experiment</data>
  <data key="d22">In situ X-ray absorption spectroscopy</data>
  <data key="d26">xas</data>
  <data key="d27">spectroscopy</data>
  <data key="d28">X-ray absorption spectroscopy</data>
  <data key="d29">in situ X-ray absorption spectroscopy</data>
  <data key="d30">[]</data>
  <data key="d31">{}</data>
  <data key="d23">Used to investigate the catalyst configuration and oxidation-state behavior during operation.</data>
  <data key="d24">["exp_in_situ_xas"]</data>
  <data key="d25">1</data>
</node>
