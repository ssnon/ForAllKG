version: '2026-08-04-semantic-si-assets-v4'
metrics:
  overpotential:
    label: Overpotential
    canonical_unit: mV
    aliases: [eta, η, HER overpotential]
  overpotential_at_10_ma_cm2:
    label: Overpotential at 10 mA cm^-2
    canonical_unit: mV
    aliases: [eta10, η10, overpotential at 10 mA cm-2]
  tafel_slope:
    label: Tafel slope
    canonical_unit: mV dec^-1
    aliases: [Tafel slopes]
  exchange_current_density:
    label: Exchange current density
    canonical_unit: mA cm^-2
    aliases: [j0, exchange current]
  charge_transfer_resistance:
    label: Charge-transfer resistance
    canonical_unit: ohm
    aliases: [Rct, charge transfer resistance]
  double_layer_capacitance:
    label: Double-layer capacitance
    canonical_unit: mF cm^-2
    aliases: [Cdl, double layer capacitance]
  electrochemically_active_surface_area:
    label: Electrochemically active surface area
    canonical_unit: cm^2
    aliases: [ECSA]
  ecsa_normalized_current_density:
    label: ECSA-normalized current density
    canonical_unit: mA cm^-2
    aliases: [specific current density]
  turnover_frequency:
    label: Turnover frequency
    canonical_unit: s^-1
    aliases: [TOF]
  mass_activity:
    label: Mass activity
    canonical_unit: A mg^-1
    aliases: [HER mass activity]
  specific_activity:
    label: Specific activity
    canonical_unit: mA cm^-2
    aliases: [specific HER activity]
  activity_retention:
    label: Activity retention
    canonical_unit: '%'
    aliases: [retention, activity remaining]
  activity_loss:
    label: Activity loss
    canonical_unit: '%'
    aliases: [HER activity loss]
  potential_drop:
    label: Potential drop
    canonical_unit: mV
    aliases: [potential increase, voltage drop]
  adsorption_energy:
    label: Adsorption energy
    canonical_unit: eV
    aliases: [binding energy, Eads]
  hydrogen_adsorption_free_energy:
    label: Hydrogen adsorption free energy
    canonical_unit: eV
    aliases: [Delta G H, ΔG_H, Gibbs free energy of H adsorption]
  bond_distance:
    label: Bond distance
    canonical_unit: angstrom
    aliases: [bond length]
  interatomic_distance:
    label: Interatomic distance
    canonical_unit: angstrom
    aliases: [direct interatomic distance, microscopy-derived distance]
  dft_optimized_bond_length:
    label: DFT-optimized bond length
    canonical_unit: angstrom
    aliases: [DFT bond length, optimized bond distance, computed bond length]
  exafs_radial_peak_position:
    label: FT-EXAFS radial peak position
    canonical_unit: angstrom
    aliases: [FT peak position, radial peak]
  fitted_scattering_path_length:
    label: EXAFS fitted scattering-path length
    canonical_unit: angstrom
    aliases: [EXAFS fitted distance, R-space fitted path length, fitted coordination path]
  coordination_number:
    label: Coordination number
    canonical_unit: null
    aliases: [CN]
  bader_charge:
    label: Bader charge
    canonical_unit: e
    aliases: [charge transfer, Bader electron transfer]
  integrated_cohp:
    label: Integrated crystal orbital Hamilton population
    canonical_unit: eV
    aliases: [ICOHP, pCOHP integral]
  raman_d_to_g_intensity_ratio:
    label: Raman D-to-G band intensity ratio
    canonical_unit: null
    parameters: []
    aliases: [ID/IG ratio, I_D/I_G ratio, Raman D/G ratio]
    match_patterns:
      - '(?i)\b(?:raman\s+)?d[- ]to[- ]g(?:\s+band)?\s+intensity\s+ratio\b'
      - '(?i)\bi[_ ]?d\s*/\s*i[_ ]?g\s+ratio\b'
  bet_surface_area:
    label: BET surface area
    canonical_unit: m2 g^-1
    parameters: []
    aliases: [BET specific surface area, Brunauer-Emmett-Teller surface area]
    match_patterns:
      - '(?i)\bBET(?:\s+specific)?\s+surface\s+area\b'
  pore_size:
    label: Pore size
    canonical_unit: nm
    parameters: []
    aliases: [Main pore size, pore diameter]
    match_patterns:
      - '(?i)\b(?:main\s+)?pore\s+(?:size|diameter)\b'
  onset_potential:
    label: Onset potential
    canonical_unit: mV
    parameters: []
    aliases: [HER onset potential]
    match_patterns:
      - '(?i)\bonset\s+potential\b'
  atomic_fraction:
    label: Atomic fraction
    canonical_unit: atomic %
    parameters: [analyte]
    aliases: [Atomic concentration, atomic percentage, atomic content]
    match_patterns:
      - '(?i)\batomic\s+(?:concentration|fraction|percentage|content)\s+of\s+(?P<analyte>[A-Z][a-z]?)\b'
      - '(?i)\b(?P<analyte>[A-Z][a-z]?)\s+atomic\s+(?:concentration|fraction|percentage|content)\b'
  element_loading:
    label: Element loading
    canonical_unit: wt %
    parameters: [analyte]
    aliases: [Metal loading, elemental loading, weight loading]
    match_patterns:
      - '(?i)\b(?P<analyte>[A-Z][a-z]?)\s+loading\b'
      - '(?i)\b(?:weight|wt)\s*%\s*(?P<analyte>[A-Z][a-z]?)\b'
  xps_binding_energy:
    label: XPS binding energy
    canonical_unit: eV
    parameters: [analyte, orbital]
    aliases: [Core-level binding energy, photoelectron binding energy]
    match_patterns:
      - '(?i)\b(?P<analyte>[A-Z][a-z]?)\s*(?P<orbital>[0-9]+[spdf](?:[0-9]+/[0-9]+)?)\s+binding\s+energy\b'
      - '(?i)\b(?P<analyte>[A-Z][a-z]?)\s*(?P<orbital>[0-9]+[spdf](?:[0-9]+/[0-9]+)?)\s+peak\b'
  bader_volume:
    label: Bader volume
    canonical_unit: pm3
    parameters: []
    aliases: [Bader atomic volume]
    match_patterns:
      - '(?i)\bbader\s+(?:atomic\s+)?volume\b'
  density_of_states_near_fermi_level:
    label: Density of states near the Fermi level
    canonical_unit: null
    parameters: [component]
    aliases: [DOS near Fermi level, occupied-state DOS near Fermi level]
    match_patterns:
      - '(?i)\b(?:occupied[- ]state\s+)?DOS\s+near\s+(?:the\s+)?Fermi\s+level\b'
  oxidation_state:
    label: Oxidation state
    canonical_unit: null
    parameters: [analyte]
    aliases: [average oxidation state, valence state, oxidation number]
    match_patterns:
      - '(?i)\b(?:average\s+)?oxidation\s+state\s+of\s+(?P<analyte>[A-Z][a-z]?)\b'
      - '(?i)\b(?P<analyte>[A-Z][a-z]?)\s+(?:average\s+)?oxidation\s+state\b'
  pcohp_antibonding_state_energy:
    label: pCOHP antibonding-state energy
    canonical_unit: eV
    parameters: [bond, site]
    aliases: [antibonding-state energy, pCOHP antibonding energy]
    match_patterns:
      - '(?i)\bpCOHP\b.*\bantibonding[- ]state\s+energy\b'
      - '(?i)\bantibonding[- ]state\s+energy\b.*\bpCOHP\b'
  epr_g_factor:
    label: EPR g factor
    canonical_unit: null
    parameters: []
    aliases: [EPR g value, electron paramagnetic resonance g factor]
    match_patterns:
      - '(?i)\bEPR\b.*\bg\s*(?:=|value|factor)\b'
      - '(?i)\bg\s*=\s*[0-9]+(?:\.[0-9]+)?\b'
