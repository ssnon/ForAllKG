    canonical_unit: null
    parameters: []
    aliases: [particle aspect ratio, nanoparticle aspect ratio]
  lattice_plane_spacing:
    label: Lattice-plane spacing
    canonical_unit: null
    parameters: [component, reflection]
    aliases: [lattice-plane separation, lattice plane separation, lattice plane spacing, d-spacing, interplanar spacing]
