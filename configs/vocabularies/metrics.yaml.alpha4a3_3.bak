    aliases: [particle yield, nanoparticle yield, nanostructure yield]
  hybridization_complex_formation:
    label: Sandwich-hybridization complex formation
    canonical_unit: null
    parameters: []
    aliases: [sandwich-hybridization complex formation, sandwich hybridization complex formation, complex formation observation]
  log_concentration_log_sers_intensity_correlation_coefficient:
    label: log concentration-log SERS intensity correlation coefficient
    canonical_unit: null
    parameters: [analyte]
    aliases: [log concentration-log SERS intensity correlation coefficient, log concentration–log SERS intensity correlation coefficient, log concentration-log intensity correlation]
  xrd_diffraction_peak_position:
    label: XRD diffraction peak position
    canonical_unit: degree
    parameters: [reflection]
    aliases: [XRD peak position, diffraction peak position, 2theta peak position]
  raman_peak_position:
    label: Raman peak position
    canonical_unit: cm^-1
    parameters: [analyte]
    aliases: [Raman shift, SERS peak position, Raman band position]
  aspect_ratio:
